{
  "name": "finance-tracker",
  "private": true,
  "version": "0.0.1",
  "description": "Personal finance and cash flow dashboard",
  "author": "Lozavival",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "build:electron": "vite build --config vite.electron.config.ts",
    "dev": "vite dev",
    "preview": "vite preview",
    "electron:dev": "npm run build && npm run build:electron && electron . --enable-features=WaylandWindowDecorations --ozone-platform-hint=auto",
    "electron:dist": "npm run build && npm run build:electron && electron-builder",
    "electron:dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "electron:dist:all": "npm run build && npm run build:electron && electron-builder -lw",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:components": "vitest run tests/components",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "npm run lint:tsc && npm run lint:ts",
    "lint:tsc": "tsc --pretty --noEmit",
    "lint:ts": "eslint --color --cache --max-warnings=0 \"src/**/*.{ts,tsx}\" \"*.{js,mjs,ts}\"",
    "lint:fix": "npm run lint:ts -- --fix",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
