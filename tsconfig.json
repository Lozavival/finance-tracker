{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/*": [
        "./src/app/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "electron",
    "vite.config.ts",
    "vite.electron.config.ts"
  ]
}
